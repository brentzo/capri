# Attacker image for the Docker sandbox range (HC-SUB-01, HC-AGENT-01 §5.3).
# This is the container where the agent's tool adapters run. It carries the pentest
# toolchain; the tools let the agent probe and exploit in-scope targets, never escape scope.
#
# It deliberately has NO NET_ADMIN (set at `docker run`) and NO nft / ip tooling, so the
# agent cannot see or reconfigure the scope guard the helper installs into this container's
# network namespace. The guard - default-deny egress, allowing only pinned in-scope
# IPs:ports - is enforced in this network namespace regardless of what tools live here, so
# nmap, chromium and the crawler can only reach what scope already allows.
#
# The base is Debian-slim (glibc), not Alpine (musl): the black-box crawler drives a real
# browser through Playwright, whose browser builds are glibc, so Playwright is first-class
# here. The harness itself never imports Playwright; it drives the crawler over `docker exec`,
# so this dependency lives only in the attacker image, like nmap and httpx.
#
# Build (on the range host, not a laptop):  docker build -t hc-attacker:golden -f Dockerfile.attacker .
# Builds on amd64 and arm64; the httpx binary is selected by TARGETARCH and checksum-pinned.
FROM python:3.12-slim-bookworm

# System toolchain. nmap: service/version detection. chromium: the headless browser the
# client-side DOM adapters drive one-shot with `--dump-dom` (DOM clobbering, prototype
# pollution, a CSP-bypassing inline marker); a real browser tool like nmap, never a harness
# dependency. procps: provides `pkill`, which `_render_dom` uses to reap wedged chromium
# helpers after each render - the Debian base does not bundle it the way Alpine's busybox did,
# and without it the --dump-dom hang guard regresses. coreutils `timeout` (also used there) is
# in the base already. wget/unzip/ca-certificates: used only to fetch and verify httpx.
RUN apt-get update && apt-get install -y --no-install-recommends \
      nmap \
      chromium \
      procps \
      wget unzip ca-certificates openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Google Android SDK command-line tools: apkanalyzer decodes binary APK manifests and
# platform-tools supplies the private ADB client used only by the harness adapter.
ARG ANDROID_CMDLINE_TOOLS_REV=15859902
ARG ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
ARG ANDROID_PLATFORM_TOOLS_REV=37.0.1
ARG ANDROID_PLATFORM_TOOLS_SHA256=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1
ENV ANDROID_HOME=/opt/android-sdk
RUN set -eux; \
    mkdir -p "$ANDROID_HOME/cmdline-tools"; \
    wget -qO /tmp/android-tools.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_REV}_latest.zip"; \
    echo "${ANDROID_CMDLINE_TOOLS_SHA256}  /tmp/android-tools.zip" | sha256sum -c -; \
    unzip -q /tmp/android-tools.zip -d "$ANDROID_HOME/cmdline-tools"; \
    mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"; \
    rm /tmp/android-tools.zip; \
    yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --sdk_root="$ANDROID_HOME" --licenses >/dev/null; \
    wget -qO /tmp/platform-tools.zip \
      "https://dl.google.com/android/repository/platform-tools_r${ANDROID_PLATFORM_TOOLS_REV}-linux.zip"; \
    echo "${ANDROID_PLATFORM_TOOLS_SHA256}  /tmp/platform-tools.zip" | sha256sum -c -; \
    unzip -q /tmp/platform-tools.zip -d "$ANDROID_HOME"; \
    rm /tmp/platform-tools.zip; \
    "$ANDROID_HOME/cmdline-tools/latest/bin/apkanalyzer" --help >/dev/null
ENV PATH="${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/cmdline-tools/latest/bin:${PATH}"

# Playwright drives a real browser for the black-box crawler (recon endpoint discovery). It
# is container tooling, pinned, installed with its own chromium and that browser's OS deps.
# The harness stays standard-library only and reaches the crawler over `docker exec`.
ARG PLAYWRIGHT_VERSION=1.47.0
RUN pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" \
    && playwright install --with-deps chromium

# ProjectDiscovery httpx (web recon and fingerprinting): a CGO-free static Go binary. Pinned
# by version and verified against the release checksum before it is installed, so a tampered
# download fails the build.
ARG TARGETARCH
ARG HTTPX_VERSION=1.12.0
ARG HTTPX_SHA256_amd64=9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76
ARG HTTPX_SHA256_arm64=fd7b123c1dfbc3d69f19f524e4eebcd6ec06b9a6cbd56813c76f11645197331e
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) sha="$HTTPX_SHA256_amd64" ;; \
      arm64) sha="$HTTPX_SHA256_arm64" ;; \
      *) echo "unsupported TARGETARCH: $arch" >&2; exit 1 ;; \
    esac; \
    zip="httpx_${HTTPX_VERSION}_linux_${arch}.zip"; \
    wget -qO /tmp/httpx.zip "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/${zip}"; \
    echo "${sha}  /tmp/httpx.zip" | sha256sum -c -; \
    unzip -oq /tmp/httpx.zip httpx -d /usr/local/bin; \
    chmod 0755 /usr/local/bin/httpx; \
    rm /tmp/httpx.zip; \
    httpx -version

# The black-box crawler, driven over `docker exec` by the recon phase. It needs Playwright
# (installed above); the harness copies nothing at runtime, so it is baked in here.
COPY crawl.py /opt/hc/crawl.py

# Optional manifest-plus-code Android assessment runs only when static_depth is "code".
# JADX and Semgrep stay in the attacker container and never send decompiled source outward.
ARG JADX_VERSION=1.5.6
ARG JADX_SHA256=545ea2be9c242511bc145755cf4bda2485ade42966e096f8b4d3da2a230e8974
ARG SEMGREP_VERSION=1.180.0
RUN set -eux; \
    wget -qO /tmp/jadx.zip "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/jadx-${JADX_VERSION}.zip"; \
    echo "${JADX_SHA256}  /tmp/jadx.zip" | sha256sum -c -; \
    mkdir -p /opt/jadx; unzip -q /tmp/jadx.zip -d /opt/jadx; \
    ln -s /opt/jadx/bin/jadx /usr/local/bin/jadx; rm /tmp/jadx.zip; \
    pip install --no-cache-dir "semgrep==${SEMGREP_VERSION}"
COPY mobile-rules.yaml /opt/hc/mobile-rules.yaml

CMD ["sleep", "infinity"]
