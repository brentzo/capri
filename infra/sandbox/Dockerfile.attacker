# Attacker image for the Docker sandbox range (HC-SUB-01, HC-AGENT-01 §5.3).
# This is the container where the agent's tool adapters run. It carries the pentest
# toolchain on top of the same tiny base the targets use; the tools let the agent probe
# and exploit in-scope targets, never escape scope.
#
# It deliberately has NO NET_ADMIN (set at `docker run`) and NO nft / ip tooling, so the
# agent cannot see or reconfigure the scope guard the helper installs into this container's
# network namespace. The guard - default-deny egress, allowing only pinned in-scope
# IPs:ports - is enforced in this network namespace regardless of what tools live here, so
# nmap and friends can only reach what scope already allows.
#
# Build (on the range host, not a laptop):  docker build -t hc-attacker:golden -f Dockerfile.attacker .
# Builds on amd64 and arm64 (Apple Silicon Docker Desktop is a self-host target), so the
# httpx binary is selected by TARGETARCH and checksum-pinned to the release.
FROM alpine:3.20
# chromium is the headless browser the client-side DOM adapters drive (DOM clobbering,
# prototype pollution, a CSP-bypassing inline marker): a real browser tool in the image,
# like nmap and httpx, run one-shot with `--dump-dom` and never a harness dependency, so
# the harness stays standard-library only. It executes page JavaScript and serializes the
# resulting DOM, which is what makes a DOM-only vulnerability observable.
RUN apk add --no-cache \
      python3 \
      nmap nmap-scripts \
      chromium

# ProjectDiscovery httpx (web recon and fingerprinting): a CGO-free static Go binary that
# runs on musl with no extra libraries. Pinned by version and verified against the
# release checksum before it is installed, so a tampered download fails the build.
ARG TARGETARCH
ARG HTTPX_VERSION=1.12.0
ARG HTTPX_SHA256_amd64=9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76
ARG HTTPX_SHA256_arm64=fd7b123c1dfbc3d69f19f524e4eebcd6ec06b9a6cbd56813c76f11645197331e
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) sha="$HTTPX_SHA256_amd64" ;; \
      arm64) sha="$HTTPX_SHA256_arm64" ;; \
      *) echo "unsupported TARGETARCH: $arch" >&2; exit 1 ;; \
    esac; \
    zip="httpx_${HTTPX_VERSION}_linux_${arch}.zip"; \
    apk add --no-cache --virtual .httpx-build unzip wget; \
    wget -qO /tmp/httpx.zip "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/${zip}"; \
    echo "${sha}  /tmp/httpx.zip" | sha256sum -c -; \
    unzip -oq /tmp/httpx.zip httpx -d /usr/local/bin; \
    chmod 0755 /usr/local/bin/httpx; \
    rm /tmp/httpx.zip; \
    apk del .httpx-build; \
    httpx -version
CMD ["sleep", "infinity"]
