#!/usr/bin/env python3
"""capri - an autonomous penetration-testing agent you self-host.

One command for the whole workflow:

    capri setup              choose your models and start the gateway (a terminal UI)
    capri run                run an engagement against the sandbox range
    capri gateway <cmd>      the model-plane gateway: status | env | down | destroy | up | keys
    capri dashboard          browse your past runs in a local web view
    capri help               show this message

Set up once with `capri setup`, then `capri run`. The harness stays standard-library
Python; `capri` dispatches to tools in this repo and starts the locked CLI UI with uv
when needed, so it also works as `./capri ...` from a checkout or PATH symlink.
"""
import os
import importlib.util
import shutil
import subprocess
import sys

# The original CAPRI banner uses box-drawing characters that Windows cp1252
# cannot encode. Keep branded CLI output readable in modern UTF-8 terminals.
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")

# realpath, so running capri through a PATH symlink still finds the repo it lives in.
ROOT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, ROOT)
from cli import terminal                                            # noqa: E402

TAGLINE = "An autonomous penetration-testing agent."

ABOUT = ("An LLM agent recons a disposable sandbox target, decides what to try,\n"
         "and chains steps toward an objective - with every action gated by the\n"
         "harness, not the model. The agent proposes; the harness disposes.")

def _indent(text, pad="  "):
    return "\n".join(pad + ln if ln else ln for ln in text.split("\n"))


def _help():
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    bold = "\033[1m" if color else ""
    dim = "\033[2m" if color else ""
    cyan = "\033[36m" if color else ""
    rst = "\033[0m" if color else ""
    separator_column = 8 + len(terminal.command("gateway destroy")) + 2

    def command_row(cmd, desc, *, indent=4):
        command = terminal.command(cmd)
        prefix = " " * indent + command
        padding = max(2, separator_column - len(prefix))
        return f"{prefix}{' ' * padding}{dim}│{rst}  {desc}"

    def group(title, entries):
        rows = [f"    {cyan}{title}{rst}"]
        rows.extend(command_row(cmd, desc, indent=8) for cmd, desc in entries)
        return "\n".join(rows)

    quick_start = "\n".join((
        command_row("setup", "choose models and start Bifrost"),
        command_row("run", "run the sandbox engagement"),
    ))
    commands = "\n\n".join((
        group("Setup", [("setup", "choose Operator and Verifier models, then start Bifrost")]),
        group("Run", [("run", "run an engagement against the sandbox")]),
        group("Local source assessment", [("source --project <path>", "scan source and dependencies offline"),
                                           ("source update-db", "download the local Trivy advisory database")]),
        group("Gateway", [("gateway up", "start the saved gateway"),
                           ("gateway status", "show gateway status"),
                           ("gateway keys", "update provider keys"),
                           ("gateway env", "print shell exports"),
                           ("gateway down", "stop the gateway"),
                           ("gateway destroy", "remove gateway data")]),
        group("Report", [("dashboard", "browse your past runs in a local web view")]),
        group("Help", [("help", "show this message")]),
    ))
    return (f"\n{terminal.render_banner(color=color)}\n\n"
            f"  {bold}{TAGLINE}{rst}\n"
            f"{dim}{_indent(ABOUT)}{rst}\n\n"
            f"  {bold}Quick start{rst}\n{quick_start}\n\n"
            f"  {bold}Commands{rst}\n{commands}\n")


def _uses_rich_ui(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        return False
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if argv[0] == "setup":
        return interactive and "--plain" not in argv[1:]
    if argv[0] == "run":
        return interactive and "--plain" not in argv[1:]
    return False


def _prepare_ui_runtime(argv):
    """Re-enter the command through the locked uv environment when the UI deps are missing."""
    if not _uses_rich_ui(argv):
        return None
    if importlib.util.find_spec("textual") and importlib.util.find_spec("rich"):
        return None
    uv = shutil.which("uv")
    if not uv:
        sys.stderr.write("Capri's interactive UI needs Textual. Install uv or use `setup --plain`.\n")
        return 1
    env = os.environ.copy()
    if env.get("CAPRI_UV_REENTRY"):
        sys.stderr.write("Capri could not load Textual from the uv environment. Run `uv sync` and retry.\n")
        return 1
    env["CAPRI_UV_REENTRY"] = "1"
    return subprocess.run([uv, "run", "--project", ROOT, "python",
                           os.path.join(ROOT, "capri"), *argv], env=env, check=False).returncode


def _state_dir_for_run():
    """The model-plane state dir, resolving the invoking user's home when run under
    sudo, so `sudo capri run` finds the gateway that `capri setup` configured."""
    import types
    from tools import modelplane
    sudo_user = os.environ.get("SUDO_USER")
    if (sudo_user and not os.environ.get("HC_MODELPLANE_DIR")
            and hasattr(os, "geteuid") and os.geteuid() == 0):
        try:
            import pwd
            home = pwd.getpwnam(sudo_user).pw_dir
            os.environ["HC_MODELPLANE_DIR"] = os.path.join(home, ".hackculture", "modelplane")
        except (KeyError, ImportError):
            pass
    return modelplane.state_dir(types.SimpleNamespace(dir=None))


def _cmd_run(rest):
    import argparse

    # Parse before anything else: a help flag or a typo must never provision the range
    # or spend model tokens.
    parser = argparse.ArgumentParser(
        prog="capri run",
        description="Run an engagement against the sandbox range. "
                    "The target is Capri's built-in demo app; the sandbox is validated before active probes.")
    parser.add_argument("--plain", action="store_true",
                        help="print progress line by line instead of the full-screen view")
    args = parser.parse_args(rest)

    from tools import modelplane

    env = modelplane.runtime_env(_state_dir_for_run())
    if env:
        for k, v in env.items():
            os.environ.setdefault(k, v)          # wire the gateway handles in-process
    if not args.plain and sys.stdin.isatty() and sys.stdout.isatty():
        from cli.ui import RunApp
        return RunApp().run()
    terminal.print_banner("RUN ENGAGEMENT", "The sandbox is validated before active probes.")
    if not env:
        print(f"note: no model plane configured yet (run `{terminal.command('setup')}` first); "
              "running with the deterministic stand-ins.\n")
    from tools import run_engagement

    return run_engagement.main()


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(_help())
        return 0
    prepared = _prepare_ui_runtime(argv)
    if prepared is not None:
        return prepared
    cmd, rest = argv[0], argv[1:]
    if cmd == "setup":
        from cli import setup
        return setup.main(rest)
    if cmd == "run":
        return _cmd_run(rest)
    if cmd == "source":
        from tools import project_assessment
        return project_assessment.main(rest)
    if cmd == "gateway":
        if not rest:
            print("usage: capri gateway <up|keys|env|status|down|destroy>")
            return 2
        from tools import modelplane
        return modelplane.main(rest)
    if cmd == "dashboard":
        from cli import dashboard
        return dashboard.main(rest)
    sys.stderr.write(f"capri: unknown command {cmd!r}\n")
    print(_help())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
