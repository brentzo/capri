#!/usr/bin/env python3
"""capri - an autonomous penetration-testing agent you self-host.

One command for the whole workflow:

    capri setup              choose your models and start the gateway (a terminal UI)
    capri run                run an engagement against the sandbox range
    capri gateway <cmd>      the model-plane gateway: status | env | down | destroy | up | keys
    capri help               show this message

Set up once with `capri setup`, then `capri run`. Everything is standard-library
Python; `capri` just dispatches to the tools in this repo, so it also works as
`./capri ...` from a checkout or symlinked onto your PATH (see `make install`).
"""
import os
import sys

# realpath, so running capri through a PATH symlink still finds the repo it lives in.
ROOT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, ROOT)
from tools import terminal                                          # noqa: E402

TAGLINE = "An autonomous penetration-testing agent."

ABOUT = ("An LLM agent recons a disposable sandbox target, decides what to try,\n"
         "and chains steps toward an objective - with every action gated by the\n"
         "harness, not the model. The agent proposes; the harness disposes.")

def _indent(text, pad="  "):
    return "\n".join(pad + ln if ln else ln for ln in text.split("\n"))


def _help():
    color = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    bold = "\033[1m" if color else ""
    dim = "\033[2m" if color else ""
    rst = "\033[0m" if color else ""
    commands = ("Commands\n"
                f"  {terminal.command('setup'):<34} choose models and start the gateway\n"
                f"  {terminal.command('run'):<34} run an engagement\n"
                f"  {terminal.command('gateway up'):<34} start the saved gateway\n"
                f"  {terminal.command('gateway status'):<34} show gateway status\n"
                f"  {terminal.command('gateway keys'):<34} update provider keys\n"
                f"  {terminal.command('gateway env'):<34} print shell exports\n"
                f"  {terminal.command('gateway down'):<34} stop the gateway\n"
                f"  {terminal.command('gateway destroy'):<34} remove gateway data\n"
                f"  {terminal.command('help'):<34} show this message")
    return (f"\n{terminal.render_banner(color=color)}\n\n"
            f"  {bold}{TAGLINE}{rst}\n\n"
            f"{dim}{_indent(ABOUT)}{rst}\n\n"
            f"{_indent(commands)}\n")


def _state_dir_for_run():
    """The model-plane state dir, resolving the invoking user's home when run under
    sudo, so `sudo capri run` finds the gateway that `capri setup` configured."""
    import types
    from tools import modelplane
    sudo_user = os.environ.get("SUDO_USER")
    if (sudo_user and not os.environ.get("HC_MODELPLANE_DIR")
            and hasattr(os, "geteuid") and os.geteuid() == 0):
        try:
            import pwd
            home = pwd.getpwnam(sudo_user).pw_dir
            os.environ["HC_MODELPLANE_DIR"] = os.path.join(home, ".hackculture", "modelplane")
        except (KeyError, ImportError):
            pass
    return modelplane.state_dir(types.SimpleNamespace(dir=None))


def _cmd_run(_rest):
    from tools import modelplane, run_engagement
    terminal.print_banner("RUN ENGAGEMENT", "The sandbox is validated before active probes.")
    env = modelplane.runtime_env(_state_dir_for_run())
    if env:
        for k, v in env.items():
            os.environ.setdefault(k, v)          # wire the gateway handles in-process
    else:
        print(f"note: no model plane configured yet (run `{terminal.command('setup')}` first); "
              "running with the deterministic stand-ins.\n")
    return run_engagement.main()


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(_help())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "setup":
        from tools import setup
        return setup.main(rest)
    if cmd == "run":
        return _cmd_run(rest)
    if cmd == "gateway":
        if not rest:
            print("usage: capri gateway <up|keys|env|status|down|destroy>")
            return 2
        from tools import modelplane
        return modelplane.main(rest)
    sys.stderr.write(f"capri: unknown command {cmd!r}\n")
    print(_help())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
